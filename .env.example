DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/erp_db?charset=utf8mb4
# 반드시 교체하세요. 아래 자리표시자 값 그대로는 서버 기동이 거부됩니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=__REPLACE_ME__run_secrets_token_urlsafe_48
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# HTTPS 배포 시 세션 쿠키에 Secure 플래그를 켠다
# COOKIE_SECURE=true

# ---------- 시간대 (회계 날짜의 단일 소스) ----------
# BUSINESS_TZ: 전표일자·발행일·채번 기간·"이번 달"의 기준이 되는 사업장 시간대.
# DB_TZ: DB 의 naive 타임스탬프(created_at 등)가 기록되는 시간대.
#        MySQL 은 세션 time_zone(기본 system), SQLite 의 CURRENT_TIMESTAMP 는 UTC.
#        DB 를 KST 로 운영한다면 DB_TZ=Asia/Seoul 로 두면 변환이 항등이 된다.
# 잘못 두면 월 경계에서 하루가 인접 월로 새고(8/1 오전 거래가 7월 매출로 기표),
# 그 달이 마감돼 있으면 정상 거래가 거부된다.
BUSINESS_TZ=Asia/Seoul
DB_TZ=UTC

# ---------- 비밀번호 정책 ----------
# 최소 길이(영문+숫자 포함·아이디 포함 금지·흔한 비밀번호 금지는 코드 고정 규칙)
PASSWORD_MIN_LENGTH=10

# ---------- 비밀번호 재설정 ----------
# 재설정 링크가 가리킬 프론트(Next 앱) 주소와 링크 유효시간(분)
APP_BASE_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=30

# ---------- 메일 발송 (선택) ----------
# SMTP_HOST 를 비워 두면 메일 발송이 꺼지고, 비밀번호 찾기는
# "관리자에게 임시 비밀번호 발급 요청" 경로로 안내된다(회원 화면에서 발급).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=someone@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=erp@example.com
# SMTP_STARTTLS=true
